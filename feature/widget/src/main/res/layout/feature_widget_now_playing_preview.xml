<?xml version="1.0" encoding="utf-8"?>
<!--
  위젯 초기 inflate(initialLayout) 용 레이아웃.
  Glance 가 실제 콘텐츠를 합성하기 전 잠깐 보이는 화면이므로, 실제 위젯을 캡처한
  미리보기 이미지(@drawable/feature_widget_preview)를 그대로 띄워 깜빡임이 자연스럽게 한다.
  피커 미리보기는 별도로 appwidget-provider 의 previewImage(동일 이미지)가 담당한다.
-->
<ImageView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:contentDescription="@string/feature_widget_now_playing_label"
    android:scaleType="centerCrop"
    android:src="@drawable/feature_widget_preview" />
