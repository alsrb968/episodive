<?xml version="1.0" encoding="utf-8"?>
<resources>
    <string name="feature_onboarding_welcome_title">언제 어디서나\n매력적인 콘텐츠에 액세스하기</string>
    <string name="feature_onboarding_welcome_description">앨범아트 색으로 물드는 몰입형 플레이어.\n당신의 취향을 아는 팟캐스트.</string>
    <string name="feature_onboarding_welcome_cta">시작하기</string>
    <string name="feature_onboarding_category_title">당신의 카테고리를 선택하세요</string>
    <string name="feature_onboarding_category_description">좋아하는 팟캐스트 장르를\n세 개 이상 선택하세요.</string>
    <string name="feature_onboarding_category_more_categories">3개 이상 선택해주세요.</string>
    <string name="feature_onboarding_next">다음</string>
    <string name="feature_onboarding_podcast_title">당신이 선호할만한 것들</string>
    <string name="feature_onboarding_podcast_description">당신이 선호하는 장르에 맞춰,\n당신의 관심사에 가장 잘 맞는\n팟캐스트를 소개합니다.</string>
    <string name="feature_onboarding_podcast_empty">선택한 카테고리에 맞는 팟캐스트를 찾지 못했어요.\n이전으로 돌아가 다시 고르거나, 그냥 넘어가도 괜찮아요.</string>
    <string name="feature_onboarding_podcast_error">팟캐스트를 불러오지 못했어요.\n네트워크를 확인하거나, 그냥 넘어가도 괜찮아요.</string>
    <string name="feature_onboarding_completion_title">정말 좋은 선택이에요!\n당신에게 딱 맞는\n최고의 팟캐스트를 찾아드릴게요!</string>
</resources>